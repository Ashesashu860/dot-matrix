{
  "name": "dot-matrix",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dots/web dev",
    "dev:all": "concurrently -k -n emu,web -c magenta,cyan \"pnpm emulators\" \"pnpm --filter @dots/web dev\"",
    "emulators": "pnpm --filter @dots/functions build && firebase emulators:start --project demo-dots-matrix",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter \"./packages/**\" --filter @dots/web --filter @dots/functions run test",
    "test:emulators": "pnpm --filter @dots/functions build && firebase emulators:exec --project demo-dots-matrix --only auth,firestore,database,functions \"pnpm --filter @dots/emulator-tests test\"",
    "e2e": "pnpm --filter @dots/e2e test",
    "format": "prettier --write .",
    "build:web:emulators": "NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true pnpm --filter @dots/web build",
    "e2e:online": "pnpm build:web:emulators && pnpm --filter @dots/functions build && firebase emulators:exec --project demo-dots-matrix --only auth,firestore,database,functions \"pnpm --filter @dots/e2e test:online\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}